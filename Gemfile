source "https://rubygems.org"

gem "jekyll", "~> 4.3"
gem "jekyll-theme-hydejack", "~> 9.2"

# libsass-based converter; the Dart Sass binary in sass-embedded fails code-signing on some macOS versions
gem "jekyll-sass-converter", "~> 2.2"

# Required for `jekyll serve` in Ruby 3
gem "webrick"

# No longer default gems in Ruby 3.4+
gem "bigdecimal"
gem "csv"
gem "base64"
gem "logger"

group :jekyll_plugins do
  gem "jekyll-default-layout"
  gem "jekyll-feed"
  gem "jekyll-optional-front-matter"
  gem "jekyll-paginate"
  gem "jekyll-readme-index"
  gem "jekyll-redirect-from"
  gem "jekyll-relative-links"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
  gem "jekyll-titles-from-headings"
  gem "jekyll-include-cache"
end
